import React, { useState } from "react";

const Chatbot = () => {
  const [step, setStep] = useState(0);
  const [formData, setFormData] = useState({
    userName: "",
    userPhone: "",
    referral: "",
    address: "",
    ownershipDuration: "",
    spouseName: "",
    fenceType: "",
    availability: "",
  });
  
  const handleInputChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const nextStep = () => setStep(step + 1);

  return (
    <div className="p-4 border rounded-lg shadow-lg max-w-md mx-auto">
      {step === 0 && (
        <>
          <p>It’s a great day here at Privacy Fence Company, how can I make you smile today?</p>
          <input type="text" name="fenceType" placeholder="Enter fence type" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 1 && (
        <>
          <p>Oh great, I would be happy to help you with that, my name is Daniel, and you are?</p>
          <input type="text" name="userName" placeholder="Your name" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 2 && (
        <>
          <p>Thank you for reaching out today {formData.userName}, in case we were to get disconnected, what is the best number to reach you on?</p>
          <input type="text" name="userPhone" placeholder="Phone number" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 3 && (
        <>
          <p>Fantastic! How did you hear about us? Were you a referral?</p>
          <input type="text" name="referral" placeholder="Referral (if any)" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 4 && (
        <>
          <p>Great! What is the street address of your home?</p>
          <input type="text" name="address" placeholder="Street, City, State, Zip" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 5 && (
        <>
          <p>And how long have you owned the home there?</p>
          <input type="text" name="ownershipDuration" placeholder="Duration" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 6 && (
        <>
          <p>Perfect! Is there a spouse in the house with you? Great, and their name is?</p>
          <input type="text" name="spouseName" placeholder="Spouse name" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 7 && (
        <>
          <p>Fantastic! What prompted you to reach out today?</p>
          <input type="text" name="reason" placeholder="Reason for inquiry" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 8 && (
        <>
          <p>Great! We can swing by to take measurements and show you design options. We’ll also leave you with a written price for planning.</p>
          <p>Are you currently working days or evenings?</p>
          <input type="text" name="availability" placeholder="Days or evenings" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 9 && (
        <>
          <p>I actually have a representative out in your area this week. Which day would work best for both of you?</p>
          <input type="text" name="appointmentDay" placeholder="Preferred day" onChange={handleInputChange} className="mt-2 p-2 border w-full" />
          <button onClick={nextStep} className="mt-4 bg-blue-500 text-white p-2 rounded">Next</button>
        </>
      )}

      {step === 10 && (
        <>
          <p>Fantastic! Someone from our office will call to confirm your appointment, and you’ll receive an email confirmation.</p>
          <p>We look forward to seeing you!</p>
        </>
      )}
    </div>
  );
};

export default Chatbot;
